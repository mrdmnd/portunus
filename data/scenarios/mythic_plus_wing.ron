// Multi-pull Mythic+ dungeon wing:
//   Pull 1 ("courtyard_pack"): 1 Dungeon Lieutenant (12M base HP, 8 forces) + 4 Dungeon Trash (4M base HP each, 2 forces each)
//   Pull 2 ("hallway_pack"):   1 Dungeon Lieutenant (12M base HP, 8 forces) + 4 Dungeon Trash (4M base HP each, 2 forces each)
//   Pull 3 ("wing_boss"):      1 Dungeon Boss (32M base HP)
// Each pull scales health uniformly in [0.85, 1.15] so policies cannot overfit to a fixed pull duration,
// and the Lieutenant is listed first so default targeting funnels single-target damage into the priority mob
// while cleave/AoE sweeps down the 4 surrounding trash mobs.
(
    name: "mythic_plus_wing",
    forces_required: Some(32),
    pulls: [
        (
            name: "courtyard_pack",
            travel_in: fixed(8000),
            prepull: 3000,
            timeout: 300000,
            health: uniform(lo: 0.85, hi: 1.15),
            waves: [
                (
                    mobs: [
                        ("dungeon_lieutenant", 1),
                        ("dungeon_trash", 4),
                    ],
                    engage: now,
                ),
            ],
        ),
        (
            name: "hallway_pack",
            travel_in: fixed(10000),
            prepull: 3000,
            timeout: 300000,
            health: uniform(lo: 0.85, hi: 1.15),
            waves: [
                (
                    mobs: [
                        ("dungeon_lieutenant", 1),
                        ("dungeon_trash", 4),
                    ],
                    engage: now,
                ),
            ],
        ),
        (
            name: "wing_boss",
            travel_in: fixed(12000),
            prepull: 3000,
            timeout: 600000,
            health: uniform(lo: 0.85, hi: 1.15),
            waves: [
                (
                    mobs: [("dungeon_boss", 1)],
                    engage: now,
                ),
            ],
        ),
    ],
)
