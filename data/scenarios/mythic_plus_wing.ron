// Multi-pull Mythic+ dungeon wing:
//   Pull 1 ("courtyard_pack"): 4 Dungeon Trash (4M base HP each, 2 forces each) + 1 Dungeon Lieutenant (12M base HP, 8 forces)
//   Pull 2 ("hallway_pack"):   4 Dungeon Trash (4M base HP each, 2 forces each) + 1 Dungeon Lieutenant (12M base HP, 8 forces)
//   Pull 3 ("wing_boss"):      1 Dungeon Boss (32M base HP)
// Each pull scales health uniformly in [0.85, 1.15] so policies cannot overfit to a fixed pull duration.
// Trash mobs are spawned before the Lieutenant so default auto-targeting starts on a low-HP trash mob
// and the policy must learn de novo to retarget onto higher-health targets.
(
    name: "mythic_plus_wing",
    forces_required: Some(32),
    pulls: [
        (
            name: "courtyard_pack",
            travel_in: fixed(8000),
            prepull: 3000,
            timeout: 300000,
            health: uniform(lo: 0.85, hi: 1.15),
            waves: [
                (
                    mobs: [
                        ("dungeon_trash", 4),
                        ("dungeon_lieutenant", 1),
                    ],
                    engage: now,
                ),
            ],
        ),
        (
            name: "hallway_pack",
            travel_in: fixed(10000),
            prepull: 3000,
            timeout: 300000,
            health: uniform(lo: 0.85, hi: 1.15),
            waves: [
                (
                    mobs: [
                        ("dungeon_trash", 4),
                        ("dungeon_lieutenant", 1),
                    ],
                    engage: now,
                ),
            ],
        ),
        (
            name: "wing_boss",
            travel_in: fixed(12000),
            prepull: 3000,
            timeout: 600000,
            health: uniform(lo: 0.85, hi: 1.15),
            waves: [
                (
                    mobs: [("dungeon_boss", 1)],
                    engage: now,
                ),
            ],
        ),
    ],
)
