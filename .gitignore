**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# rustc ICE dumps
rustc-ice-*.txt

# Editor / IDE
*.swp
.vscode/settings.json
frontend/.vscode/settings.json

# Misc local artifacts
__pycache__/
frontend/site.db
